{
  "expo": {
    "name": "Tasbeeh Counter Pro",
    "slug": "tasbeeh-counter-pro",
    "version": "1.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#0A1A0F",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A1A0F"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.tasbeehcounterpro.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Your location is used on this device to calculate prayer times and the Qibla direction."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A1A0F"
      },
      "package": "com.zaheen.counter",
      "permissions": [
        "VIBRATE",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "POST_NOTIFICATIONS",
        "RECEIVE_BOOT_COMPLETED"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "versionCode": 2
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "backgroundColor": "#0A1A0F",
      "themeColor": "#C9A84C",
      "name": "Tasbeeh Counter Pro",
      "shortName": "Tasbeeh",
      "description": "Islamic Dhikr Counter with Authentic Hadith References",
      "orientation": "portrait",
      "display": "standalone",
      "startUrl": "/",
      "scope": "/",
      "lang": "en",
      "dir": "ltr"
    },
    "extra": {
      "eas": {
        "projectId": "f7df800a-3d9a-43c4-8dc0-a7e6bd9dcb50"
      }
    },
    "owner": "devzaheens-organization",
    "plugins": [
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Your location is used on this device to calculate prayer times and the Qibla direction."
        }
      ],
      "expo-notifications",
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ]
    ]
  }
}
